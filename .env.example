# Switch between mock data and the real Delever Custom Integration API V2.
# Keep "true" until you receive Delever API credentials.
USE_MOCKS=true

# Delever Custom Integration API V2 credentials (request from Delever).
# When USE_MOCKS=false, all three values below MUST be set.
#
# Per Delever docs: client_secret is itself base64(username:password). The
# values are sent in the OAuth POST body (NOT as an HTTP Basic header).
# Delever Custom Integration API V2 hostname.
# The OpenAPI spec uses `servers: [{ url: "/" }]` so the actual hostname is
# whatever Delever provides for your account. Default below matches the
# canonical public host; ask Delever support if your integrator profile
# uses a different one.
DELEVER_BASE_URL=https://api.delever.io
DELEVER_CLIENT_ID=
DELEVER_CLIENT_SECRET=

# Optional overrides — defaults match the public Delever V2 spec.
# DELEVER_OAUTH_PATH=/v1/custom-integration/security/oauth/token
# DELEVER_API_BASE_PATH=/v1/custom-integration
# DELEVER_GRANT_TYPE=client_credentials
# DELEVER_SCOPE=
