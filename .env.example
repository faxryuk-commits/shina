# Switch between mock data and the real Delever API.
# Keep "true" until you receive Delever API credentials.
USE_MOCKS=true

# Delever API V2 credentials (request from Delever).
# When USE_MOCKS=false, all three values below MUST be set.
DELEVER_BASE_URL=https://api.delever.io
DELEVER_CLIENT_ID=
DELEVER_CLIENT_SECRET=

# Optional: override the OAuth token endpoint path.
# Default: /security/oauth/token (relative to DELEVER_BASE_URL).
# DELEVER_OAUTH_PATH=/security/oauth/token
